    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.10.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "supabase": "^2.81.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
