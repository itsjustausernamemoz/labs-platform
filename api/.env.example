# Copy to .env for local dev, or set these as environment variables in cPanel's
# "Setup Node.js App" screen for production — never commit a real .env file.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=mashqzco_admin
DB_PASSWORD=
DB_NAME=mashqzco_academics

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://slab-student.web.app,https://lab-lecturer.web.app,https://mashoke-admin.web.app,https://mashoke-institution-admin.web.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# At least one of these is required for AI grading / focus reports.
GEMINI_API_KEY=
OPENAI_API_KEY=
